# PlayMigrate — Variables de entorno
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA subas .env.local a git.

# Spotify (obtener en https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=tu_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_client_secret_aqui

# Deezer (obtener en https://developers.deezer.com)
DEEZER_APP_ID=tu_app_id_aqui
DEEZER_APP_SECRET=tu_app_secret_aqui

# NextAuth (generar con: openssl rand -base64 32)
NEXTAUTH_SECRET=genera_un_string_secreto_aqui
